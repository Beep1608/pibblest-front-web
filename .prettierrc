{
	"arrowParens": "avoid",
	"htmlWhitespaceSensitivity": "ignore",
	"overrides": [
		{
			"files": "*.md",
			"options": {
				"printWidth": 80
			}
		},
		{
			"files": ["*.component.html", "*.html"],
			"options": {
				"parser": "angular"
			}
		}
	],
	"plugins": [
		"prettier-plugin-organize-imports",
		"prettier-plugin-organize-attributes",
		"prettier-plugin-multiline-arrays"
	],
	"printWidth": 120,
	"singleQuote": true,
	"tabWidth": 2,
	"useTabs": true
}
